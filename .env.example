# Supabase — create a project at https://supabase.com
# Copy this file to .env.local and fill in your values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only — NEVER prefix with NEXT_PUBLIC_ (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Signed httpOnly session after OTP (min 16 random chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Gemini — AI Doctor photo analysis (REQUIRED for real diagnosis)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# data.gov.in — live mandi prices (optional, server-only)
DATA_GOV_API_KEY=

# Weather: Open-Meteo is the primary source (no API key required).
# Optional OpenWeather fallback if Open-Meteo is unreachable:
# Free key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Firebase Auth (Google Sign-In — Phone OTP removed)
# Console: Authentication → Sign-in method → Google → Enable
# Also add your Vercel domain under Authentication → Settings → Authorized domains
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789

# SMS OTP removed from app — MSG91/Twilio only if you re-enable later
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Admin Expert Console
# Main Owner login: password only = ADMIN_PANEL_SECRET (min 12 chars)
# Experts: Owner creates username/password under /admin/experts
# Generate: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PANEL_SECRET=

# Optional public app URL (used in expert-reply SMS/WhatsApp deep links)
NEXT_PUBLIC_APP_URL=https://agriveda-theta.vercel.app

# Twilio WhatsApp (optional) — when set, expert replies also go via WhatsApp
# Example sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Capacitor Android WebView target — production MUST be HTTPS
# Play Store: https://your-app.vercel.app
CAPACITOR_SERVER_URL=https://agriveda-theta.vercel.app
# Local LAN only: CAPACITOR_ALLOW_CLEARTEXT=true + http://PC_IP:3000
# CAPACITOR_ALLOW_CLEARTEXT=

# Dev-only: skip onboarding when NEXT_PUBLIC_SKIP_ONBOARDING=true (ignored in production)
# NEXT_PUBLIC_SKIP_ONBOARDING=true
